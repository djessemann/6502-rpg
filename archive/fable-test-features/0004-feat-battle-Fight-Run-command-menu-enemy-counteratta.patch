     lda menu_cursor
     bne @m_open_equip   ; cursor 1 = Equip
     ; cursor 0 = Talk
@@ -1252,9 +1320,45 @@ sd_src_hi: .res STREAM_MAX  ; source pointer high
     sta player_atk
